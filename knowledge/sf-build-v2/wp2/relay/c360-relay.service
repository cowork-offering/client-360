[Unit]
Description=Customer 360 execution relay (org callout -> REST Actions API re-entry)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=/opt/connectry/c360-relay/.env
ExecStart=/home/fabian/.bun/bin/bun run /opt/connectry/c360-relay/server.ts
WorkingDirectory=/opt/connectry/c360-relay
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
