/**
 * Customer360Covenants — MCP tool: covenant compliance.
 *
 * Reads the MODERN covenant object only: LLC_BI__Covenant2__c.
 * LLC_BI__Covenant__c (legacy) is empty org-wide (0 records) — never queried.
 *
 * Covenant2 carries its own threshold (Financial_Indicator_Value__c), its own
 * actual reading (Last_Evaluation_Value__c), and status — unlike the legacy
 * object, no separate ratio lookup is needed to know compliance; this tool
 * surfaces what nCino already evaluated. The Boom MCP's ratio is still the
 * source for ratios that feed a NEW covenant test before nCino re-evaluates;
 * compose at the agent layer for forward-looking covenant analysis.
 *
 * Scoped to relationship-level covenants (LLC_BI__Account__c on Covenant2).
 * Loan-level covenant association goes through a separate junction object
 * (LLC_BI__Loan_Covenant__c) not read here — the verified demo data
 * (Piedmont's 4 covenants) is relationship-level, matching this scope.
 *
 * All fields verified live against the bankinggpt sandbox (sobject-sf MCP,
 * 2026-07-01).
 */
global with sharing class Customer360Covenants {

    global class Request {
        @InvocableVariable(label='Account Id' description='Salesforce Account Id of the customer/relationship anchor.' required=true)
        global String accountId;
    }

    global class AttachedLoan {
        @InvocableVariable(label='Loan Id')
        global String loanId;
        @InvocableVariable(label='Loan Name')
        global String loanName;
    }

    global class Covenant {
        @InvocableVariable(label='Covenant Id')
        global String covenantId;
        @InvocableVariable(label='Covenant Type')
        global String covenantType;
        @InvocableVariable(label='Threshold (Financial Indicator Value)')
        global Decimal thresholdValue;
        @InvocableVariable(label='Actual (Last Evaluation Value)')
        global Decimal actualValue;
        @InvocableVariable(label='Last Evaluation Status')
        global String lastEvaluationStatus;
        @InvocableVariable(label='Last Evaluation Date')
        global String lastEvaluationDate;
        @InvocableVariable(label='Next Evaluation Date')
        global String nextEvaluationDate;
        @InvocableVariable(label='Days Until Next Evaluation')
        global Decimal daysUntilNextEvaluation;
        @InvocableVariable(label='Frequency')
        global String frequency;
        @InvocableVariable(label='Breached')
        global Boolean breached;
        @InvocableVariable(label='Covenant Status')
        global String covenantStatus;
        @InvocableVariable(label='Attached Loans' description='Facilities this covenant is attached to through LLC_BI__Loan_Covenant__c. An EMPTY list is the fact that the covenant is relationship-level, not a gap: there is no separate level flag on this object and the list IS the answer.')
        global List<AttachedLoan> attachedLoans;
        @InvocableVariable(label='Latest Compliance Id' description='The most recently created LLC_BI__Covenant_Compliance2__c row for this covenant, or null when none exists. stage_covenant_review anchors on it. Null is a real answer: compliance rows are generated by managed automation, so a covenant can legitimately have none.')
        global String latestComplianceId;
        @InvocableVariable(label='Latest Compliance Status' description='LLC_BI__Status__c on that row: Compliant, Exception, In Progress, Pending or Waived. Distinct from the covenant-level status above.')
        global String latestComplianceStatus;
        @InvocableVariable(label='Reason For Exception' description='LLC_BI__Reason_for_Exception__c on that row: Breached or Overdue. THE field that separates a failed test from an undelivered document. nCino forces Exception onto any row whose due date has passed, measured or not, so Exception alone must never be read as a breach. Null when the row carries no reason.')
        global String reasonForException;
    }

    global class Response {
        @InvocableVariable(label='Account Id')
        global String accountId;
        @InvocableVariable(label='Covenants')
        global List<Covenant> covenants;
        @InvocableVariable(label='Note')
        global String note;
    }

    @InvocableMethod(
        label='Customer 360: Covenant Compliance'
        description='Active relationship-level covenants from the modern nCino covenant object: threshold, last-evaluated actual, status, and the next test date with days remaining.'
    )
    global static List<Response> getCovenants(List<Request> requests) {
        List<Response> results = new List<Response>();

        for (Request req : requests) {
            Response res = new Response();
            res.accountId = req.accountId;
            res.covenants = new List<Covenant>();

            List<LLC_BI__Covenant2__c> rows = [
                SELECT Id, LLC_BI__Covenant_Type__r.Name, LLC_BI__Financial_Indicator_Value__c,
                       LLC_BI__Last_Evaluation_Value__c, LLC_BI__Last_Evaluation_Status__c,
                       LLC_BI__Last_Evaluation_Date__c, LLC_BI__Next_Evaluation_Date__c,
                       LLC_BI__Days_Until_Next_Evaluation__c, LLC_BI__Frequency__c,
                       LLC_BI__Breached__c, LLC_BI__Covenant_Status__c
                FROM LLC_BI__Covenant2__c
                WHERE LLC_BI__Account__c = :req.accountId
                  AND LLC_BI__Active__c = true
                WITH USER_MODE
                ORDER BY LLC_BI__Next_Evaluation_Date__c ASC NULLS LAST
            ];

            // Most recent compliance row per covenant, in one query rather than one per covenant.
            // "Most recent" is defined as most recently CREATED, which is unambiguous and stable;
            // a covenant with no compliance row yields null, and null must flow through as null
            // rather than being smoothed into a missing field.
            Set<Id> covenantIds = new Set<Id>();
            for (LLC_BI__Covenant2__c c : rows) {
                covenantIds.add(c.Id);
            }
            // Loan attachment, one query for all covenants. The junction's covenant field is
            // LLC_BI__Covenant2__c (NOT LLC_BI__Covenant__c, which is the legacy object).
            Map<Id, List<AttachedLoan>> loansByCovenant = new Map<Id, List<AttachedLoan>>();
            if (!covenantIds.isEmpty()) {
                for (LLC_BI__Loan_Covenant__c lc : [
                    SELECT Id, LLC_BI__Covenant2__c, LLC_BI__Loan__c, LLC_BI__Loan__r.Name
                    FROM LLC_BI__Loan_Covenant__c
                    WHERE LLC_BI__Covenant2__c IN :covenantIds
                    WITH USER_MODE
                    ORDER BY LLC_BI__Loan__r.Name ASC NULLS LAST
                ]) {
                    if (!loansByCovenant.containsKey(lc.LLC_BI__Covenant2__c)) {
                        loansByCovenant.put(lc.LLC_BI__Covenant2__c, new List<AttachedLoan>());
                    }
                    AttachedLoan al = new AttachedLoan();
                    al.loanId = lc.LLC_BI__Loan__c;
                    al.loanName = lc.LLC_BI__Loan__r != null ? lc.LLC_BI__Loan__r.Name : null;
                    loansByCovenant.get(lc.LLC_BI__Covenant2__c).add(al);
                }
            }

            // The latest compliance row per covenant, carrying its status and its Reason for
            // Exception. Reading the reason is what lets a caller separate an administrative miss
            // from a real failed test instead of inferring it from whether a value was measured:
            // nCino's exception batch forces Exception the moment a due date passes, so the
            // inference is honest and still an inference. Additive fields, no shape break.
            Map<Id, LLC_BI__Covenant_Compliance2__c> latestComplianceByCovenant = new Map<Id, LLC_BI__Covenant_Compliance2__c>();
            if (!covenantIds.isEmpty()) {
                for (LLC_BI__Covenant_Compliance2__c cc : [
                    SELECT Id, LLC_BI__Covenant__c, LLC_BI__Status__c, LLC_BI__Reason_for_Exception__c
                    FROM LLC_BI__Covenant_Compliance2__c
                    WHERE LLC_BI__Covenant__c IN :covenantIds
                    WITH USER_MODE
                    ORDER BY CreatedDate DESC
                ]) {
                    // Ordered newest first, so the first row seen per covenant is the latest.
                    if (!latestComplianceByCovenant.containsKey(cc.LLC_BI__Covenant__c)) {
                        latestComplianceByCovenant.put(cc.LLC_BI__Covenant__c, cc);
                    }
                }
            }

            for (LLC_BI__Covenant2__c c : rows) {
                Covenant cv = new Covenant();
                cv.covenantId = c.Id;
                cv.covenantType = c.LLC_BI__Covenant_Type__r != null ? c.LLC_BI__Covenant_Type__r.Name : null;
                cv.thresholdValue = c.LLC_BI__Financial_Indicator_Value__c;
                cv.actualValue = c.LLC_BI__Last_Evaluation_Value__c;
                cv.lastEvaluationStatus = c.LLC_BI__Last_Evaluation_Status__c;
                cv.lastEvaluationDate = c.LLC_BI__Last_Evaluation_Date__c != null ? String.valueOf(c.LLC_BI__Last_Evaluation_Date__c) : null;
                cv.nextEvaluationDate = c.LLC_BI__Next_Evaluation_Date__c != null ? String.valueOf(c.LLC_BI__Next_Evaluation_Date__c) : null;
                cv.daysUntilNextEvaluation = c.LLC_BI__Days_Until_Next_Evaluation__c;
                cv.frequency = c.LLC_BI__Frequency__c;
                cv.breached = c.LLC_BI__Breached__c;
                cv.covenantStatus = c.LLC_BI__Covenant_Status__c;
                LLC_BI__Covenant_Compliance2__c latest = latestComplianceByCovenant.get(c.Id);
                cv.latestComplianceId = latest == null ? null : latest.Id;
                cv.latestComplianceStatus = latest == null ? null : latest.LLC_BI__Status__c;
                cv.reasonForException = latest == null ? null : latest.LLC_BI__Reason_for_Exception__c;
                // Always a list, never null: an empty list means relationship-level, and the
                // caller should be able to read that without a null check.
                cv.attachedLoans = loansByCovenant.containsKey(c.Id)
                    ? loansByCovenant.get(c.Id)
                    : new List<AttachedLoan>();
                res.covenants.add(cv);
            }

            res.note = res.covenants.isEmpty()
                ? 'No active relationship-level covenants found for this account.'
                : 'Threshold x actual already evaluated by nCino as of Last Evaluation Date. For a live ratio ahead of the next scheduled test, compose with the Boom MCP ratio tools at the agent layer.';
            results.add(res);
        }

        return results;
    }
}
