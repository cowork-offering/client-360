<?xml version="1.0" encoding="UTF-8"?>
<!--
  The execution relay host. ExecuteLoanModification calls out here when it runs in a context that
  cannot host nCino's credit-action engine; the relay re-enters the org over REST, where it can.
-->
<RemoteSiteSetting xmlns="http://soap.sforce.com/2006/04/metadata">
    <disableProtocolSecurity>false</disableProtocolSecurity>
    <isActive>true</isActive>
    <url>https://bot.connectry.io</url>
</RemoteSiteSetting>
